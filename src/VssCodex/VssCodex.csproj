<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VssCodex: the cross-platform vss-codex tool. It decompiles the Vintage Story binaries, generates
    the API + Harmony markdown references, installs the curated docs, and renders the vss skill.
    One entry point (dotnet run). Runs on Windows, Linux and macOS.
    OUTPUT is derived from VS binaries and must only ever be written into the gitignored out/ tree.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>vss-codex</AssemblyName>
    <RootNamespace>VssCodex</RootNamespace>
    <Version>1.2.0</Version>
    <Description>Generate a complete, always-current Vintage Story modding reference (API, Harmony catalog, events/enums, engine internals) and a Claude Code skill, straight from the game binaries.</Description>
    <Authors>qheri5</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/qheri5/vss-codex</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cross-platform: Mono.Cecil from NuGet (no coupling to a local VS install path). -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- The skill source + curated docs travel with the tool so it is self-contained at runtime. -->
    <Content Include="..\..\docs-src\**\*.md">
      <Link>content\docs-src\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\skill\**\*">
      <Link>content\skill\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
