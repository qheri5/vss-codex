<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VssCodex — the generator at the heart of the vss-codex knowledge-base builder.
    Reflects over the local Vintage Story binaries with Mono.Cecil (shipped in the VS install)
    to emit the API + Harmony markdown references + a build-info.json handoff for the formatter.

    This project is committable. Its OUTPUT is proprietary (derived from VS binaries) and must only
    ever be written into the gitignored vs-game-reference/ tree — see ../../vss-codex.ps1.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VssCodex</AssemblyName>
    <RootNamespace>VssCodex</RootNamespace>
    <!-- DEV only on PC: reference Mono.Cecil from the local VS install (same convention as the mods) -->
    <VintagestoryDir>$(APPDATA)\Vintagestory</VintagestoryDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Mono.Cecil">
      <HintPath>$(VintagestoryDir)\Lib\Mono.Cecil.dll</HintPath>
      <!-- Private=true: copy Cecil next to the tool so it runs standalone -->
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
